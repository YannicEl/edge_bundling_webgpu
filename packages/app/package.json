		"@types/node": "24.3.1",
		"@webgpu/types": "0.1.64",
		"postcss-nesting": "13.0.2",
		"svelte": "5.38.7",
		"svelte-check": "4.3.1",
		"typescript": "5.9.2",
		"unocss": "66.5.0",
		"unplugin-icons": "22.2.0",
		"vite": "7.1.4",
		"wrangler": "4.34.0"
